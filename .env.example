# Local Postgres from docker-compose.yml (port 5433 because 5432 is taken).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/receipts

# Groq (secret)
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_DAILY_CALL_BUDGET=200

AUTO_APPROVE_THRESHOLD=0.85
MAX_FILE_BYTES=5242880
MAX_PDF_PAGES=3
FILE_RETENTION_HOURS=24
RECORD_RETENTION_DAYS=7
PROCESSING_TIMEOUT_SECONDS=120

RATE_LIMIT_ENABLED=true
RATE_LIMIT_UPLOAD=5/minute;30/day
RATE_LIMIT_READ=60/minute
RATE_LIMIT_REVIEW=20/minute

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REVIEW_PASSCODE=
ADMIN_TOKEN=
PUBLIC_BASE_URL=

APP_VERSION=0.1.0
ENV=development
LOG_LEVEL=INFO
